<component type="desktop-application">
  <id>io.github.enteraname74.soulsearching</id>
  <name>Soul Searching</name>
  <summary>Listen to and manage your local music collection</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-or-later</project_license>
  <description>
    <p>
      Soul Searching is a customizable music player for listening to and
      managing a local music collection.
    </p>
    <p>
      It supports playlists, multiple artists, synchronized lyrics, listening
      statistics, metadata editing, search, sorting, and dynamic themes based
      on album artwork.
    </p>
  </description>
